{
  "schema_version": 1,
  "name": "zip",
  "endian": "little",
  "fields": [
    {"name": "entries", "type": "repeat", "until": "tag_mismatch", "fields": [
      {"name": "signature", "type": "bytes", "length": 4, "expect": "504b0304"},
      {"name": "version_needed", "type": "u16"},
      {"name": "flags", "type": "u16"},
      {"name": "method", "type": "u16"},
      {"name": "mod_time", "type": "u16"},
      {"name": "mod_date", "type": "u16"},
      {"name": "crc32", "type": "u32"},
      {"name": "compressed_size", "type": "u32"},
      {"name": "uncompressed_size", "type": "u32"},
      {"name": "name_length", "type": "u16"},
      {"name": "extra_length", "type": "u16"},
      {"name": "name", "type": "string", "encoding": "utf8", "length": {"field": "name_length"}},
      {"name": "extra", "type": "bytes", "length": {"field": "extra_length"}},
      {"name": "data", "type": "bytes", "length": {"field": "compressed_size"}}
    ]},
    {"name": "central_directory", "type": "repeat", "until": "tag_mismatch", "fields": [
      {"name": "signature", "type": "bytes", "length": 4, "expect": "504b0102"},
      {"name": "version_made_by", "type": "u16"},
      {"name": "version_needed", "type": "u16"},
      {"name": "flags", "type": "u16"},
      {"name": "method", "type": "u16"},
      {"name": "mod_time", "type": "u16"},
      {"name": "mod_date", "type": "u16"},
      {"name": "crc32", "type": "u32"},
      {"name": "compressed_size", "type": "u32"},
      {"name": "uncompressed_size", "type": "u32"},
      {"name": "name_length", "type": "u16"},
      {"name": "extra_length", "type": "u16"},
      {"name": "comment_length", "type": "u16"},
      {"name": "disk_start", "type": "u16"},
      {"name": "internal_attributes", "type": "u16"},
      {"name": "external_attributes", "type": "u32"},
      {"name": "local_header_offset", "type": "u32"},
      {"name": "name", "type": "string", "encoding": "utf8", "length": {"field": "name_length"}},
      {"name": "extra", "type": "bytes", "length": {"field": "extra_length"}},
      {"name": "comment", "type": "string", "encoding": "utf8", "length": {"field": "comment_length"}}
    ]},
    {"name": "end_signature", "type": "bytes", "length": 4, "expect": "504b0506"},
    {"name": "end_disk", "type": "u16"},
    {"name": "end_central_disk", "type": "u16"},
    {"name": "end_entries_on_disk", "type": "u16"},
    {"name": "end_entries_total", "type": "u16"},
    {"name": "end_central_size", "type": "u32"},
    {"name": "end_central_offset", "type": "u32"},
    {"name": "end_comment_length", "type": "u16"},
    {"name": "end_comment", "type": "string", "encoding": "utf8", "length": {"field": "end_comment_length"}}
  ]
}
